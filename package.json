{
  "name": "prabhu-traders",
  "version": "1.0.0",
  "description": "Prabhu Traders / MAXYWALK - Premium Leather E-Commerce",
  "type": "module",
  "scripts": {
    "build": "cd client && npm run build",
    "postinstall": "cd client && npm install && cd ../server && npm install",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "cd client && npm run dev",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@neondatabase/serverless": "^0.10.4",
    "@smithy/node-http-handler": "^4.4.7",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nodemailer": "^10.6.1",
    "razorpay": "^2.9.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

{
  "name": "prabhu-traders",
  "version": "1.0.0",
  "description": "Prabhu Traders / MAXYWALK - Premium Leather E-Commerce",
  "scripts": {
    "build": "cd client && npm run build",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "cd client && npm run dev",
    "server": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

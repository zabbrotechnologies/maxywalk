{
  "version": 2,
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/admin/emails/process-queue?cron_key=maxywalk_cron_secret_2026",
      "schedule": "*/2 * * * *"
    }
  ],
  "regions": [
    "cle1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}